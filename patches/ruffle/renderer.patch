+/// Admit recurring bitmap target sizes, not one-time map/asset construction.
+#[derive(Debug, Default)]
+pub(crate) struct DrawHistory {
+    last_frame: Option<u64>,
+    reused_this_frame: bool,
+}
+
+impl DrawHistory {
+    pub(crate) fn should_reuse(&mut self, frame: u64) -> bool {
+        if self.last_frame != Some(frame) {
+            self.reused_this_frame = self
+                .last_frame
+                .and_then(|last| frame.checked_sub(last))
+                .is_some_and(|age| age > 0 && age <= 4);
+            self.last_frame = Some(frame);
+        }
+        self.reused_this_frame
+    }
+
+    pub(crate) fn last_frame(&self) -> u64 {
+        self.last_frame.unwrap_or(0)
+    }
+}
