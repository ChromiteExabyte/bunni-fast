+//! Crop an offscreen capture on its ORIGINAL physical-pixel grid.
+//! Inputs/outputs are twips after the complete display/view transform.
+pub(crate) fn crop_on_original_grid(bounds: [i32; 4], clip: [i32; 4]) -> Option<[i32; 4]> {
+    if bounds[0] >= bounds[2] || bounds[1] >= bounds[3] || clip[0] >= clip[2] || clip[1] >= clip[3]
+    {
+        return None;
+    }
+    let mut result = bounds;
+    for axis in 0..2 {
+        let origin = i64::from(bounds[axis]);
+        let low = i64::from(clip[axis]) - 20; // one physical pixel for bilinear/MSAA edges
+        let high = i64::from(clip[axis + 2]) + 20;
+        let start = origin + (low - origin).div_euclid(20) * 20;
+        let end = origin - (-(high - origin)).div_euclid(20) * 20;
+        result[axis] = origin.max(start).min(i64::from(bounds[axis + 2])) as i32;
+        result[axis + 2] = i64::from(bounds[axis + 2]).min(end).max(origin) as i32;
+    }
+    (result[0] < result[2] && result[1] < result[3]).then_some(result)
+}
