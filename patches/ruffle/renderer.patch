+                assert_eq!((new[0] - old[0]) % 20, 0);
+                assert_eq!((new[1] - old[1]) % 20, 0);
+                assert!(new[0] == old[0] || new[0] <= -20);
+                assert!(new[1] == old[1] || new[1] <= -20);
+                assert!(new[2] >= 1620 && new[3] >= 1220);
+            }
+        }
+    }
