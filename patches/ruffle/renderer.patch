+    #[test]
+    fn unbounded_pool_preserves_original_semantics() {
+        let mut a = IdlePool::new(None);
+        for i in 0..100 {
+            a.push(i);
+        }
+        assert_eq!(a.entries.len(), 100);
+        assert_eq!(a.swap_remove(12), 12);
+        assert_eq!(a.entries.len(), 99);
