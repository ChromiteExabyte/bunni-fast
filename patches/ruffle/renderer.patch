+#[cfg(test)]
+mod history_tests {
+    use super::DrawHistory;
+    #[test]
+    fn one_time_and_same_frame_draws_keep_stock_lifetime() {
+        let mut history = DrawHistory::default();
+        for _ in 0..100 {
+            assert!(!history.should_reuse(100));
+        }
+    }
+    #[test]
+    fn recurring_draws_are_reused_within_and_between_frames() {
+        let mut history = DrawHistory::default();
+        assert!(!history.should_reuse(100));
+        assert!(history.should_reuse(102));
+        assert!(history.should_reuse(102));
+        assert!(history.should_reuse(106));
+    }
+    #[test]
+    fn long_gap_returns_to_stock_lifetime_then_warms_again() {
+        let mut history = DrawHistory::default();
+        assert!(!history.should_reuse(1));
+        assert!(history.should_reuse(2));
+        assert!(!history.should_reuse(50));
+        assert!(!history.should_reuse(50));
+        assert!(history.should_reuse(51));
+    }
+    #[test]
+    fn frame_counter_wrap_falls_back_safely() {
+        let mut history = DrawHistory::default();
+        assert!(!history.should_reuse(u64::MAX));
+        assert!(!history.should_reuse(0));
+        assert!(history.should_reuse(1));
+    }
