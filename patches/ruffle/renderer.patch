+//! Admission-bounded idle resource cache. Leased resources are not counted.
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+#[derive(Debug)]
+pub(crate) struct CacheBudget {
+    used: AtomicUsize,
+    limit: usize,
+}
+
+impl CacheBudget {
+    pub(crate) fn new(limit: usize) -> Self {
+        Self {
+            used: AtomicUsize::new(0),
+            limit,
+        }
+    }
+
+    fn reserve(&self, bytes: usize) -> bool {
+        let mut used = self.used.load(Ordering::Relaxed);
+        loop {
+            let Some(next) = used.checked_add(bytes).filter(|next| *next <= self.limit) else {
+                return false;
+            };
+            match self
+                .used
+                .compare_exchange_weak(used, next, Ordering::Relaxed, Ordering::Relaxed)
+            {
+                Ok(_) => return true,
+                Err(actual) => used = actual,
+            }
+        }
+    }
+
+    fn release(&self, bytes: usize) {
+        let previous = self.used.fetch_sub(bytes, Ordering::Relaxed);
+        debug_assert!(previous >= bytes);
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct CachePolicy {
+    pub(crate) budget: Arc<CacheBudget>,
+    pub(crate) entry_bytes: usize,
+    pub(crate) max_entries: usize,
+}
+
+/// All mutations go through these methods so late lease returns obey the same cap.
+pub(crate) struct IdlePool<T> {
+    pub(crate) entries: Vec<T>,
+    policy: Option<CachePolicy>,
+}
+
+impl<T> IdlePool<T> {
+    pub(crate) fn new(policy: Option<CachePolicy>) -> Self {
+        Self {
+            entries: Vec::new(),
+            policy,
+        }
+    }
+
+    pub(crate) fn push(&mut self, item: T) {
+        if let Some(policy) = &self.policy
+            && (self.entries.len() >= policy.max_entries
+                || !policy.budget.reserve(policy.entry_bytes))
+        {
+            return;
+        }
+        self.entries.push(item);
+    }
+
+    pub(crate) fn swap_remove(&mut self, index: usize) -> T {
+        let item = self.entries.swap_remove(index);
+        if let Some(policy) = &self.policy {
+            policy.budget.release(policy.entry_bytes);
+        }
+        item
+    }
+}
+
+impl<T> Drop for IdlePool<T> {
+    fn drop(&mut self) {
+        if let Some(policy) = &self.policy {
+            policy
+                .budget
+                .release(policy.entry_bytes * self.entries.len());
+        }
+    }
+}
+
+/// Saturating accounting includes compressed blocks, array layers and MSAA samples.
+pub(crate) fn texture_storage_bytes(
+    width: u32,
+    height: u32,
+    layers: u32,
+    block_width: u32,
+    block_height: u32,
+    block_bytes: u32,
+    samples: u32,
+) -> usize {
+    let bytes = u64::from(width.div_ceil(block_width))
+        .saturating_mul(u64::from(height.div_ceil(block_height)))
+        .saturating_mul(u64::from(layers))
+        .saturating_mul(u64::from(block_bytes))
+        .saturating_mul(u64::from(samples));
+    usize::try_from(bytes).unwrap_or(usize::MAX)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Mutex;
+
+    fn pool(budget: &Arc<CacheBudget>, cost: usize, count: usize) -> IdlePool<u32> {
+        IdlePool::new(Some(CachePolicy {
+            budget: budget.clone(),
+            entry_bytes: cost,
+            max_entries: count,
+        }))
+    }
+
+    #[test]
+    fn global_budget_and_per_key_limit_both_apply() {
+        let budget = Arc::new(CacheBudget::new(100));
+        let mut a = pool(&budget, 30, 2);
+        let mut b = pool(&budget, 30, 4);
+        a.push(1);
+        a.push(2);
+        a.push(3);
+        b.push(4);
+        b.push(5);
+        assert_eq!(a.entries, vec![1, 2]);
+        assert_eq!(b.entries, vec![4]);
+        assert_eq!(budget.used.load(Ordering::Relaxed), 90);
+        assert_eq!(a.swap_remove(0), 1);
+        b.push(5);
+        assert_eq!(budget.used.load(Ordering::Relaxed), 90);
+        drop(a);
+        drop(b);
+        assert_eq!(budget.used.load(Ordering::Relaxed), 0);
+    }
+
+    #[test]
+    fn oversized_and_overflow_costs_are_never_retained() {
+        let budget = Arc::new(CacheBudget::new(100));
+        let mut a = pool(&budget, usize::MAX, 4);
+        a.push(1);
+        assert!(a.entries.is_empty());
+        assert!(!budget.reserve(usize::MAX));
+        assert_eq!(budget.used.load(Ordering::Relaxed), 0);
+    }
+
+    #[test]
+    fn late_returns_obey_budget_and_evicted_pool_cannot_resurrect() {
+        let budget = Arc::new(CacheBudget::new(30));
+        let a = Arc::new(Mutex::new(pool(&budget, 30, 4)));
+        let weak = Arc::downgrade(&a);
+        let mut b = pool(&budget, 30, 4);
+        b.push(1);
+        weak.upgrade().unwrap().lock().unwrap().push(2);
+        assert!(a.lock().unwrap().entries.is_empty());
+        drop(b);
+        a.lock().unwrap().push(3);
+        assert_eq!(budget.used.load(Ordering::Relaxed), 30);
+        drop(a);
+        assert!(weak.upgrade().is_none());
+        assert_eq!(budget.used.load(Ordering::Relaxed), 0);
+    }
+
