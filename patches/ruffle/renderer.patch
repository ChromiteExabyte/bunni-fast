+mod tests {
+    use super::*;
+    #[test]
+    fn keeps_subpixel_phase_and_guard_band() {
+        let old = [-17496, -6804, 42480, 21600];
+        let new = crop_on_original_grid(old, [0, 0, 28800, 21600]).unwrap();
+        assert_eq!(new, [-36, -24, 28824, 21600]);
+        assert_eq!((new[0] - old[0]) % 20, 0);
+        assert_eq!((new[1] - old[1]) % 20, 0);
+    }
+    #[test]
+    fn smaller_content_is_unchanged() {
+        let old = [35, 42, 500, 600];
+        assert_eq!(crop_on_original_grid(old, [0, 0, 8000, 6000]), Some(old));
+    }
+    #[test]
+    fn empty_and_disjoint_bounds_fall_back() {
+        assert_eq!(crop_on_original_grid([0, 0, 0, 20], [0, 0, 100, 100]), None);
+        assert_eq!(
+            crop_on_original_grid([200, 200, 400, 400], [0, 0, 100, 100]),
+            None
+        );
+    }
+    #[test]
+    fn extreme_disjoint_coordinates_fall_back_without_wrapping() {
+        assert_eq!(
+            crop_on_original_grid(
+                [i32::MAX - 10, i32::MAX - 10, i32::MAX, i32::MAX],
+                [i32::MIN, i32::MIN, i32::MIN + 100, i32::MIN + 100]
+            ),
+            None
+        );
+        assert_eq!(
+            crop_on_original_grid(
+                [i32::MIN, i32::MIN, i32::MIN + 10, i32::MIN + 10],
+                [i32::MAX - 100, i32::MAX - 100, i32::MAX, i32::MAX]
+            ),
+            None
+        );
+    }
+    #[test]
+    fn extreme_coordinates_do_not_overflow() {
+        let result =
+            crop_on_original_grid([i32::MIN, i32::MIN, i32::MAX, i32::MAX], [-20, -20, 20, 20])
+                .unwrap();
+        assert!(result[0] <= -40 && result[2] >= 40);
+        assert!(result[1] <= -40 && result[3] >= 40);
+    }
+    #[test]
+    fn clipped_bounds_stay_inside_original_on_whole_pixel_offsets() {
+        for x in -45..0 {
+            for y in -45..0 {
+                let old = [x, y, 3200, 2400];
+                let new = crop_on_original_grid(old, [0, 0, 1600, 1200]).unwrap();
+                assert!(new[0] >= old[0] && new[1] >= old[1]);
